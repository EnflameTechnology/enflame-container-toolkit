#!/bin/sh

set -e

case "$1" in
    configure)
        /usr/bin/enflame-ctk --quiet config --config-file=/etc/enflame-container-runtime/config.toml --in-place
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
